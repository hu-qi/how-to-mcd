{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/public_api"
    },
    {
      "source": "/",
      "destination": "/api/public_api"
    }
  ],
  "functions": {
    "api/public_api.rs": {
      "maxDuration": 60
    }
  }
}
