{
  "id": "fish-sandwich",
  "name": "香酥鱼柳堡 · 家庭风味",
  "summary": "使用白身鱼片、面包糠和酸黄瓜酱的家庭鱼柳汉堡，非商业产品工艺。",
  "servings": 2,
  "minutes": 35,
  "equipment": [
    "空气炸锅或烤箱",
    "食品温度计",
    "三个浅盘"
  ],
  "ingredients": [
    {
      "name": "去刺白身鱼片",
      "amount": 260,
      "unit": "g"
    },
    {
      "name": "汉堡胚",
      "amount": 2,
      "unit": "个"
    },
    {
      "name": "面粉",
      "amount": 30,
      "unit": "g"
    },
    {
      "name": "鸡蛋",
      "amount": 1,
      "unit": "个"
    },
    {
      "name": "面包糠",
      "amount": 50,
      "unit": "g"
    },
    {
      "name": "蛋黄酱",
      "amount": 25,
      "unit": "g"
    },
    {
      "name": "酸黄瓜",
      "amount": 20,
      "unit": "g"
    },
    {
      "name": "食用油",
      "amount": 10,
      "unit": "ml"
    }
  ],
  "steps": [
    "确认鱼片已去刺，在低温冷藏环境下解冻；用纸巾吸干表面水分。",
    "面粉、打散鸡蛋和面包糠分别置于浅盘，鱼片依次均匀裹粉、蛋液与面包糠。",
    "轻刷少量食用油，将鱼片单层放入已预热至 190°C 的空气炸锅或烤箱，烹饪约 12–16 分钟，依据厚度调整。",
    "用食品温度计确认鱼片中心温度至少达到 63°C；做酱料时将酸黄瓜切碎与蛋黄酱拌匀。",
    "将汉堡胚加热后放入熟鱼片和酱料，趁热食用。"
  ],
  "allergens": [
    "鱼类",
    "小麦",
    "鸡蛋"
  ],
  "safety": [
    "鱼类中心温度至少 63°C",
    "确认去刺并避免交叉污染",
    "蛋黄酱及鱼片勿在室温长时间放置"
  ],
  "attribution": "社区原创家庭风味食谱，非麦当劳官方配方。"
}
