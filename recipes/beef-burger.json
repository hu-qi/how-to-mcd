{
  "id": "beef-burger",
  "name": "芝士牛肉汉堡 · 家庭风味",
  "summary": "煎制牛肉饼搭配芝士、酸黄瓜和酱料；独立创作，不是任何品牌的商业配方。",
  "servings": 2,
  "minutes": 30,
  "equipment": [
    "平底锅",
    "食品温度计",
    "砧板"
  ],
  "ingredients": [
    {
      "name": "牛肉馅",
      "amount": 260,
      "unit": "g"
    },
    {
      "name": "汉堡胚",
      "amount": 2,
      "unit": "个"
    },
    {
      "name": "芝士片",
      "amount": 2,
      "unit": "片"
    },
    {
      "name": "酸黄瓜",
      "amount": 30,
      "unit": "g"
    },
    {
      "name": "洋葱",
      "amount": 40,
      "unit": "g"
    },
    {
      "name": "番茄酱",
      "amount": 20,
      "unit": "g"
    },
    {
      "name": "食用油",
      "amount": 8,
      "unit": "ml"
    },
    {
      "name": "盐",
      "amount": 2,
      "unit": "g"
    }
  ],
  "steps": [
    "洗手并清洁台面；处理生牛肉的刀具和砧板不得接触熟食及配菜。",
    "将牛肉馅分成两份压成等厚肉饼，表面少量撒盐；生肉应始终冷藏，临煎前取出。",
    "平底锅中火加热少量油，放入肉饼煎至两面上色，用食品温度计确认肉饼最厚处中心温度达到 71°C。",
    "关小火，肉饼上放芝士片稍微融化；同时把汉堡胚切面烘热。",
    "放上熟牛肉饼、芝士、洋葱、酸黄瓜及少量番茄酱后组合，立即食用。"
  ],
  "allergens": [
    "牛奶（芝士）",
    "小麦（汉堡胚）",
    "酱料其他过敏原以包装为准"
  ],
  "safety": [
    "牛肉馅制成的肉饼中心温度至少 71°C",
    "生熟砧板、夹具严格分开",
    "肉饼切勿依据颜色判断安全熟度"
  ],
  "attribution": "社区原创家庭风味食谱，非麦当劳官方配方。"
}
