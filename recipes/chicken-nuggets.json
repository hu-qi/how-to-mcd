{
  "id": "chicken-nuggets",
  "name": "香酥鸡块 · 家庭风味",
  "summary": "用整块鸡胸肉制作的家常香酥鸡块，适合空气炸锅。",
  "servings": 2,
  "minutes": 35,
  "equipment": [
    "空气炸锅",
    "食品温度计",
    "切菜板",
    "两个浅碗"
  ],
  "ingredients": [
    {
      "name": "鸡胸肉",
      "amount": 300,
      "unit": "g"
    },
    {
      "name": "鸡蛋",
      "amount": 1,
      "unit": "个"
    },
    {
      "name": "面包糠",
      "amount": 70,
      "unit": "g"
    },
    {
      "name": "面粉",
      "amount": 40,
      "unit": "g"
    },
    {
      "name": "食用油",
      "amount": 10,
      "unit": "ml"
    },
    {
      "name": "盐",
      "amount": 3,
      "unit": "g"
    }
  ],
  "steps": [
    "洗手并区分生熟工作区，将鸡胸肉切成均匀小块，撒盐调味。",
    "分别准备面粉、打散的鸡蛋和面包糠。",
    "鸡块依次裹面粉、蛋液和面包糠，轻喷或刷上少量食用油。",
    "空气炸锅预热到 190°C，单层摆放鸡块，烹饪约 12–16 分钟并中途翻面。",
    "确认最大块鸡肉中心温度至少达到 74°C，再取出食用；不同尺寸时间会不同。"
  ],
  "allergens": [
    "小麦/麸质",
    "鸡蛋"
  ],
  "safety": [
    "不使用接触生鸡肉的器具接触熟食",
    "鸡肉中心温度至少 74°C",
    "生蛋液及剩余裹粉材料不可未经加热直接食用"
  ],
