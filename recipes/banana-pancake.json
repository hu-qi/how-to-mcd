{
  "id": "banana-pancake",
  "name": "香蕉早餐松饼 · 家庭风味",
  "summary": "面向家庭厨房的社区独立原创版本，不保证与官方商品口味或工艺一致。",
  "servings": 2,
  "minutes": 25,
  "equipment": [
    "平底不粘锅",
    "搅拌盆"
  ],
  "ingredients": [
    {
      "name": "面粉",
      "amount": 110,
      "unit": "g"
    },
    {
      "name": "鸡蛋",
      "amount": 1,
      "unit": "个"
    },
    {
      "name": "巴氏杀菌牛奶",
      "amount": 120,
      "unit": "ml"
    },
    {
      "name": "香蕉",
      "amount": 1,
      "unit": "根"
    },
    {
      "name": "食用油",
      "amount": 8,
      "unit": "ml"
    }
  ],
  "steps": [
    "洗手并剥香蕉捣成泥，蛋与牛奶搅拌均匀。",
    "加入面粉及香蕉泥，搅成较厚、无干粉的面糊。",
    "平底锅刷少量油，中小火舀入面糊，表面凝固后翻面，煎至两面金黄且内部无生面糊。",
    "略降温后直接食用，切勿尝生面糊或生鸡蛋。"
  ],
  "allergens": [
    "小麦",
    "鸡蛋",
    "牛奶"
  ],
  "safety": [
    "面粉和鸡蛋须煎熟",
    "儿童食用注意温度"
  ],
  "attribution": "社区原创家庭风味食谱，非麦当劳官方配方。"
