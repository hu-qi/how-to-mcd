{
  "id": "oat-cookies",
  "name": "烤燕麦曲奇 · 家庭风味",
  "summary": "面向家庭厨房的社区独立原创版本，不保证与官方商品口味或工艺一致。",
  "servings": 8,
  "minutes": 40,
  "equipment": [
    "烤箱",
    "烤盘",
    "烘焙纸"
  ],
  "ingredients": [
    {
      "name": "燕麦片",
      "amount": 140,
      "unit": "g"
    },
    {
      "name": "低筋面粉",
      "amount": 60,
      "unit": "g"
    },
    {
      "name": "鸡蛋",
      "amount": 1,
      "unit": "个"
    },
    {
      "name": "黄油",
      "amount": 55,
      "unit": "g"
    },
    {
      "name": "细砂糖",
      "amount": 45,
      "unit": "g"
    }
  ],
  "steps": [
    "洗手并预热烤箱至175°C，黄油软化但不必熔化。",
    "将黄油与糖拌匀，加入鸡蛋、燕麦片和面粉，混合成可塑面团。",
    "分成8个小团压扁，摆在铺纸烤盘上并留足间距。",
    "烘烤约14–18分钟至表面金黄，移出冷却，确认没有生面糊后食用。"
  ],
  "allergens": [
    "小麦",
    "鸡蛋",
    "牛奶（黄油）",
    "燕麦可能交叉接触麸质"
  ],
  "safety": [
    "生面粉和蛋液不可直接食用",
    "烤盘高温谨防烫伤"
  ],
  "attribution": "社区原创家庭风味食谱，非麦当劳官方配方。"
}
